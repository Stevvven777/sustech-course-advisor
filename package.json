{
  "name": "sustech-course-advisor",
  "version": "0.2.7",
  "description": "Guided, evidence-aware course planning for SUSTech students",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stevvven777/sustech-course-advisor.git"
  },
  "bugs": {
    "url": "https://github.com/Stevvven777/sustech-course-advisor/issues"
  },
  "homepage": "https://github.com/Stevvven777/sustech-course-advisor#readme",
  "keywords": ["sustech", "course-planning", "agent-skill", "timetable"],
  "type": "module",
  "bin": { "sustech-advisor": "dist/cli.js" },
  "files": ["dist", "skills", "LICENSE", "README.md", "THIRD_PARTY_NOTICES.md"],
  "engines": { "node": ">=20.18.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/test/advisor.test.js",
    "privacy:staged": "node scripts/check-privacy.mjs --staged",
    "privacy:tracked": "node scripts/check-privacy.mjs --tracked",
    "license:check": "node scripts/check-licenses.mjs",
    "release:check": "node scripts/check-release-version.mjs",
    "validate:skill": "node scripts/validate-skill.mjs",
    "prepack": "npm run check && npm test && npm run validate:skill && npm run privacy:tracked && npm run license:check && npm run release:check"
  },
  "dependencies": { "exceljs": "^4.4.0" },
  "overrides": { "uuid": "^11.1.1" },
  "devDependencies": { "@types/node": "^22.15.30", "typescript": "^5.8.3" }
}
